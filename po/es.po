#: contents/config/config.qml:13
msgctxt "@title"
msgid "Server"
msgstr "Servidor"

#: contents/config/config.qml:18
msgctxt "@title"
msgid "Appearance"
msgstr "Apariencia"

#: contents/config/config.qml:23
msgctxt "@title"
msgid "Behavior"
msgstr "Comportamiento"

#: contents/ui/ConfigAppearance.qml:52
msgctxt "@title:group"
msgid "Icon:"
msgstr "Icono:"

#: contents/ui/ConfigAppearance.qml:53
msgctxt "@option:radio"
msgid "Filled adaptive icon"
msgstr "Icono adaptativo relleno"

#: contents/ui/ConfigAppearance.qml:61
msgctxt "@option:radio"
msgid "Outlined adaptive icon"
msgstr "Icono adaptativo contorneado"

#: contents/ui/ConfigAppearance.qml:69
msgctxt "@option:radio"
msgid "Filled dark icon"
msgstr "Icono oscuro relleno"

#: contents/ui/ConfigAppearance.qml:77
msgctxt "@option:radio"
msgid "Filled light icon"
msgstr "Icono claro relleno"

#: contents/ui/ConfigAppearance.qml:85
msgctxt "@option:radio"
msgid "Outlined dark icon"
msgstr "Icono oscuro contorneado"

#: contents/ui/ConfigAppearance.qml:93
msgctxt "@option:radio"
msgid "Outlined light icon"
msgstr "Icono claro contorneado"

#: contents/ui/ConfigBehavior.qml:59
msgctxt "@label:checkbox"
msgid "Input:"
msgstr "Entrada:"

#: contents/ui/ConfigBehavior.qml:60
msgctxt "@option:check"
msgid "Use Enter to send message"
msgstr "Usar Enter para enviar mensaje"

#: contents/ui/ConfigBehavior.qml:62
msgctxt "@info:tooltip"
msgid ""
"When enabled: Enter sends message, Ctrl+Enter adds new line.\n"
"When disabled: Enter adds new line, use 'send' button to submit."
msgstr ""
"Activado: Enter envía el mensaje, Ctrl+Enter añade nueva línea.\n"
"Desactivado: Enter añade nueva línea, usar el botón 'enviar' para mandar."

#: contents/ui/ConfigBehavior.qml:70
msgctxt "@label:checkbox"
msgid "Sound:"
msgstr "Sonido:"

#: contents/ui/ConfigBehavior.qml:71
msgctxt "@option:check"
msgid "Play sound when AI response is complete"
msgstr "Reproducir sonido cuando la respuesta de IA esté completa"

#: contents/ui/ConfigBehavior.qml:73
msgctxt "@info:tooltip"
msgid "Play a slight beep sound effect after the response is completed."
msgstr "Reproduce un ligero pitido después de que la respuesta esté completada."

#: contents/ui/ConfigBehavior.qml:81
msgctxt "@label:checkbox"
msgid "Text rendering:"
msgstr "Renderizado de texto:"

#: contents/ui/ConfigBehavior.qml:82
msgctxt "@option:check"
msgid "Enable markdown rendering in AI responses"
msgstr "Habilitar renderizado de markdown en respuestas de IA"

#: contents/ui/ConfigBehavior.qml:84
msgctxt "@info:tooltip"
msgid ""
"Render markdown formatting (bold, italics, code blocks, etc.) in AI "
"responses. When disabled, responses are shown as plain text."
msgstr ""
"Renderiza el formato markdown (negrita, cursiva, bloques de código, etc.) en "
"las respuestas de IA. Cuando está desactivado, las respuestas se muestran "
"como texto plano."

#: contents/ui/ConfigBehavior.qml:113
msgctxt "@label:spinbox"
msgid "Response timeout:"
msgstr "Tiempo de espera:"

#: contents/ui/ConfigBehavior.qml:126
msgctxt "@info"
msgid "s  (no limit)"
msgstr "s  (sin límite)"

#: contents/ui/ConfigBehavior.qml:127
msgctxt "@info"
msgid "s"
msgstr "s"

#: contents/ui/ConfigBehavior.qml:131
msgctxt "@info:tooltip"
msgid ""
"Maximum time to wait for a streaming response. Set to 0 to disable the "
"timeout. Increase this for slow models that generate long responses."
msgstr ""
"Tiempo máximo de espera para una respuesta en streaming. Poner 0 para "
"deshabilitar. Aumentar para modelos lentos que generan respuestas largas."

#: contents/ui/ConfigBehavior.qml:139
msgctxt "@label:checkbox"
msgid "Debug logging:"
msgstr "Registro de depuración:"

#: contents/ui/ConfigBehavior.qml:140
msgctxt "@option:check"
msgid "Enable debug console logs"
msgstr "Habilitar registros de consola de depuración"

#: contents/ui/ConfigBehavior.qml:142
msgctxt "@info:tooltip"
msgid ""
"Show debug console.log messages for troubleshooting. This setting is "
"persisted."
msgstr ""
"Muestra mensajes de console.log de depuración para solución de problemas. "
"Esta configuración se mantiene persistente."

#: contents/ui/ConfigServer.qml:41
msgctxt "@label:textbox"
msgid "Ollama Server URL:"
msgstr "URL del servidor Ollama:"

#: contents/ui/ConfigServer.qml:42
msgctxt "@info:placeholder"
msgid "http://127.0.0.1:11434"
msgstr "http://127.0.0.1:11434"

#: contents/ui/ConfigServer.qml:48
msgctxt "@info:tooltip"
msgid ""
"URL of the Ollama server. Use localhost (127.0.0.1) for local server or LAN "
"IP for remote server"
msgstr ""
"URL del servidor Ollama. Use localhost (127.0.0.1) para servidor local o IP "
"de LAN para servidor remoto"

#: contents/ui/ConfigServer.qml:54
msgctxt "@info"
msgid ""
"Examples:\n"
"• Local server: http://127.0.0.1:11434\n"
"• Remote server: http://192.168.1.100:11434"
msgstr ""
"Ejemplos:\n"
"• Servidor local: http://127.0.0.1:11434\n"
"• Servidor remoto: http://192.168.1.100:11434"

#: contents/ui/ConfigServer.qml:67
msgctxt "@label"
msgid "Temperature"
msgstr "Temperatura"

#: contents/ui/ConfigServer.qml:89
msgctxt "@info"
msgid "Lower = more deterministic, higher = more creative (0.0–2.0)"
msgstr "Menor = más determinista, mayor = más creativo (0.0–2.0)"

#: contents/ui/ConfigServer.qml:96
msgctxt "@label:checkbox"
msgid "System prompt"
msgstr "Indicación del sistema"

#: contents/ui/ConfigServer.qml:97
msgctxt "@option"
msgid "Enable system prompt"
msgstr "Habilitar indicación del sistema"

#: contents/ui/ConfigServer.qml:101
msgctxt "@info"
msgid "Prepend a system message to every API request. Do not include secrets."
msgstr "Antepone un mensaje del sistema a cada solicitud. No incluya secretos."

#: contents/ui/ConfigServer.qml:110
msgctxt "@info:placeholder"
msgid "You are a helpful assistant that answers questions in plain English."
msgstr "Eres un asistente útil que responde preguntas en español sencillo."

#: contents/ui/ConfigServer.qml:138
msgctxt "@info"
msgid "Long prompts may increase request size."
msgstr "Las indicaciones largas pueden aumentar el tamaño de la solicitud."

#: contents/ui/main.qml:430
msgid ""
"Network error — could not reach the Ollama server. Check that Ollama is "
"running and the server URL is correct."
msgstr ""
"Error de red — no se pudo alcanzar el servidor Ollama. Verifique que Ollama "
"esté en ejecución y que la URL del servidor sea correcta."

#: contents/ui/main.qml:440
msgid ""
"Request timed out. For slow models, increase the response timeout in "
"Settings → Behavior, or set it to 0 to disable."
msgstr ""
"La solicitud expiró. Para modelos lentos, aumente el tiempo de espera en "
"Configuración → Comportamiento, o póngalo en 0 para desactivarlo."


#: contents/ui/main.qml:926
msgctxt "@action:button"
msgid "Copy %1"
msgstr "Copiar %1"

#: contents/ui/main.qml:928
msgctxt "@action:button"
msgid "Copy block %1"
msgstr "Copiar bloque %1"
